{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentalPolicyOptimizerCampaign",
  "type": "object",
  "required": ["campaign_id", "status", "max_iterations", "baseline_policy_path", "trusted_paths"],
  "properties": {
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"const": "experimental"},
    "max_iterations": {"type": "integer", "minimum": 1, "maximum": 10},
    "baseline_policy_path": {"type": "string", "minLength": 1},
    "trusted_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_agent_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_total_tokens": {"type": "integer", "minimum": 1},
        "max_agent_calls": {"type": "integer", "minimum": 1}
      },
      "minProperties": 1
    }
  },
  "additionalProperties": false
}
