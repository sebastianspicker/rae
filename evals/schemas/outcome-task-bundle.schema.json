{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentalAutonomousCodeChangeTaskBundle",
  "type": "object",
  "required": ["benchmark_id", "status", "tasks"],
  "properties": {
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "status": {
      "const": "experimental"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "outcome-task-spec.schema.json"
      }
    }
  },
  "additionalProperties": false
}
