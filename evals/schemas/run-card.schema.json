{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/run-card.schema.json",
  "title": "RunCard",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "enum": ["benchmark-run", "operator-run", "vendor-doc"]
    },
    "benchmark_id": {
      "type": "string"
    },
    "benchmark_version": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "split": {
      "type": "string",
      "enum": ["dev", "held-out", "stress", "ablation"]
    },
    "system": {
      "type": "object",
      "required": ["model", "runtime"],
      "properties": {
        "model": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "tool_adapter": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "judge_version": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "result_path": {
      "type": "string",
      "pattern": "^evals/results/"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "pass", "fail", "blocked", "observed"]
    },
    "observation_id": {
      "type": "string"
    },
    "observation_date": {
      "type": "string",
      "format": "date"
    },
    "capabilities_observed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities_unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contamination_notes": {
      "type": "string"
    },
    "interpretation_limits": {
      "type": "string"
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_spec_path": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "routed_runtime": {
      "type": "string"
    },
    "router": {
      "type": "object"
    },
    "trace_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoint_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ledger_path": {
      "type": "string"
    },
    "regression_report_path": {
      "type": "string"
    },
    "judge_calibration_report_path": {
      "type": "string"
    },
    "release_gate_status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "release_gate_report_path": {
      "type": "string"
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "latency_seconds": {
      "type": "number",
      "minimum": 0
    },
    "resource_usage": {
      "type": "object",
      "required": ["measurement_status", "agent_duration_seconds", "agent_calls", "max_parallelism", "missing_measurements"],
      "properties": {
        "measurement_status": {"type": "string", "enum": ["complete", "partial", "unavailable"]},
        "agent_duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "agent_calls": {"type": "integer", "minimum": 0},
        "command_events": {"type": "integer", "minimum": 0},
        "max_parallelism": {"type": "integer", "minimum": 1},
        "missing_measurements": {"type": "array", "items": {"type": "string"}},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "date",
    "system",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_type": {
            "enum": ["operator-run", "vendor-doc"]
          }
        },
        "required": ["evidence_type"]
      },
      "then": {
        "required": [
          "observation_id",
          "observation_date",
          "capabilities_observed",
          "interpretation_limits"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": {
            "const": "vendor-doc"
          }
        },
        "required": ["evidence_type"]
      },
      "then": {
        "required": ["source_links"]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "evidence_type": {
              "enum": ["operator-run", "vendor-doc"]
            }
          },
          "required": ["evidence_type"]
        }
      },
      "then": {
        "required": [
          "benchmark_id",
          "benchmark_version",
          "split",
          "judge_version",
          "command",
          "result_path"
        ]
      }
    }
  ],
  "additionalProperties": false
}
