{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutonomousOutcomeComparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_type",
    "benchmark_id",
    "split",
    "task_matrix_digest",
    "repeat_count",
    "task_attempt_count",
    "evaluator_manifest",
    "evaluator_manifest_digest",
    "baseline_policy_id",
    "baseline_policy_digest",
    "baseline_report_digest",
    "challenger_report_digest",
    "policy_id",
    "policy_digest",
    "success_rate",
    "paired_wins",
    "paired_losses",
    "paired_win_ids",
    "paired_loss_ids",
    "efficiency_gain",
    "hard_failure_classes",
    "hard_metric_regressions",
    "complete",
    "resource_usage",
    "status"
  ],
  "properties": {
    "evidence_type": { "const": "autonomous-outcome-comparison" },
    "benchmark_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "split": { "const": "dev" },
    "task_matrix_digest": { "$ref": "#/$defs/digest" },
    "repeat_count": { "type": "integer", "minimum": 1, "maximum": 3 },
    "task_attempt_count": { "type": "integer", "minimum": 1, "maximum": 12 },
    "evaluator_manifest": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "evaluator_manifest_digest": { "$ref": "#/$defs/digest" },
    "baseline_policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "baseline_policy_digest": { "$ref": "#/$defs/digest" },
    "baseline_report_digest": { "$ref": "#/$defs/digest" },
    "challenger_report_digest": { "$ref": "#/$defs/digest" },
    "policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "paired_wins": { "type": "integer", "minimum": 0, "maximum": 12 },
    "paired_losses": { "type": "integer", "minimum": 0, "maximum": 12 },
    "paired_win_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "paired_loss_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "efficiency_gain": { "type": "number" },
    "hard_failure_classes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "hard_metric_regressions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "complete": { "type": "boolean" },
    "resource_usage": { "$ref": "outcome-report.schema.json#/$defs/resource_usage" },
    "status": { "enum": ["pass", "fail"] }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
