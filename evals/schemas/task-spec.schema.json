{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/task-spec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "required": [
    "task_id",
    "title",
    "split",
    "family",
    "horizon",
    "expected_runtime"
  ],
  "$defs": {
    "commandContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "success_signal": {
          "type": "string"
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "why"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  },
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "enum": ["dev", "held-out", "stress", "ablation"]
    },
    "family": {
      "type": "string"
    },
    "horizon": {
      "type": "string",
      "enum": ["single-step", "iterative", "multi-phase"]
    },
    "writes_code": {
      "type": "boolean"
    },
    "requires_story_plan": {
      "type": "boolean"
    },
    "requires_explicit_gates": {
      "type": "boolean"
    },
    "repo_hygiene_operation": {
      "type": "boolean"
    },
    "destructive_operation": {
      "type": "boolean"
    },
    "expected_runtime": {
      "type": "string",
      "enum": ["orchestration", "ralph", "tool"]
    },
    "execution_profile": {
      "type": "string"
    },
    "workflow_verb": {
      "type": "string",
      "enum": ["discover", "plan", "implement", "review", "compound"]
    },
    "delegation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "verify", "guard", "required_evidence"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "out_of_scope_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependency_task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verify": {
          "$ref": "#/$defs/commandContract"
        },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule"],
          "properties": {
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "metric": {
              "type": "string"
            }
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRequirement"
          },
          "minItems": 1
        },
        "fallback_rule": {
          "type": "string"
        }
      }
    },
    "claim_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_checkpoint": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "gate_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required_for": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
