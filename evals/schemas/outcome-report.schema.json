{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutonomousOutcomeReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_type",
    "benchmark_id",
    "split",
    "task_matrix_digest",
    "repeat_count",
    "task_attempt_count",
    "evaluator_manifest",
    "evaluator_manifest_digest",
    "policy_id",
    "policy_digest",
    "aggregate",
    "repeats"
  ],
  "properties": {
    "evidence_type": { "const": "autonomous-outcome-report" },
    "benchmark_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "split": { "enum": ["dev", "held-out", "stress", "ablation"] },
    "task_matrix_digest": { "$ref": "#/$defs/digest" },
    "repeat_count": { "type": "integer", "minimum": 1, "maximum": 3 },
    "task_attempt_count": { "type": "integer", "minimum": 1, "maximum": 12 },
    "evaluator_manifest": { "$ref": "#/$defs/manifest" },
    "evaluator_manifest_digest": { "$ref": "#/$defs/digest" },
    "policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "aggregate": { "$ref": "#/$defs/aggregate" },
    "repeats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": { "$ref": "#/$defs/task_result" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifest": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "resource_usage": {
      "type": "object",
      "required": ["measurement_status", "missing_measurements"],
      "properties": {
        "measurement_status": { "enum": ["complete", "partial", "unavailable", "incomplete"] },
        "missing_measurements": { "type": "array", "items": { "type": "string" } },
        "agent_duration_seconds": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "agent_calls": { "type": "integer", "minimum": 0 },
        "max_parallelism": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeat_count", "task_attempt_count", "success_rate", "hard_failure_classes", "complete", "resource_usage", "status"],
      "properties": {
        "repeat_count": { "type": "integer", "minimum": 1, "maximum": 3 },
        "task_attempt_count": { "type": "integer", "minimum": 1, "maximum": 12 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "hard_failure_classes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "complete": { "type": "boolean" },
        "resource_usage": { "$ref": "#/$defs/resource_usage" },
        "status": { "enum": ["pass", "fail"] }
      }
    },
    "task_result": {
      "type": "object",
      "required": ["task_id", "verdict", "failure_classes"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["pass", "fail"] },
        "failure_classes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "resource_usage": { "$ref": "#/$defs/resource_usage" }
      },
      "additionalProperties": true
    }
  }
}
