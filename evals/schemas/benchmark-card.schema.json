{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/benchmark-card.schema.json",
  "title": "BenchmarkCard",
  "type": "object",
  "required": [
    "benchmark_id",
    "version",
    "family",
    "status",
    "scenario_path",
    "task_specs_path",
    "split_policy",
    "success_metric",
    "failure_classes",
    "judge_type",
    "judge_version",
    "judge_path",
    "contamination_risk",
    "publication_status",
    "claim_links",
    "regression_policy",
    "release_gate"
  ],
  "properties": {
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "experimental", "frozen", "deprecated"]
    },
    "scenario_path": {
      "type": "string",
      "pattern": "^evals/scenarios/"
    },
    "task_specs_path": {
      "type": "string",
      "pattern": "^evals/datasets/"
    },
    "split_policy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["dev", "held-out", "stress", "ablation"]
      }
    },
    "success_metric": {
      "type": "string"
    },
    "failure_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "judge_type": {
      "type": "string",
      "enum": ["programmatic", "rubric", "hybrid"]
    },
    "judge_version": {
      "type": "string"
    },
    "judge_path": {
      "type": "string",
      "pattern": "^evals/judges/"
    },
    "contamination_risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "publication_status": {
      "type": "string",
      "enum": ["internal-only", "public-draft", "public-reportable"]
    },
    "claim_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "regression_policy": {
      "type": "object",
      "required": ["baseline_results", "minimum_metrics", "max_negative_delta"],
      "properties": {
        "baseline_results": {
          "type": "object"
        },
        "minimum_metrics": {
          "type": "object"
        },
        "max_negative_delta": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "resource_policy": {
      "type": "object",
      "properties": {
        "require_measurement": {"type": "boolean"},
        "max_agent_duration_seconds": {"type": "number", "minimum": 0},
        "max_total_tokens": {"type": "integer", "minimum": 0},
        "max_agent_calls": {"type": "integer", "minimum": 0},
        "max_parallelism": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "release_gate": {
      "type": "object",
      "required": ["required_splits", "block_on_pending_checkpoints", "required_claim_links"],
      "properties": {
        "required_splits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["dev", "held-out", "stress", "ablation"]
          }
        },
        "block_on_pending_checkpoints": {
          "type": "boolean"
        },
        "required_claim_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
