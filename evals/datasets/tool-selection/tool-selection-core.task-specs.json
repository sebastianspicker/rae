    {
      "task_id": "tool-selection-dev-orchestration",
      "title": "Route gated multi-phase work to orchestration",
      "split": "dev",
      "family": "tool-selection",
      "horizon": "multi-phase",
      "writes_code": true,
      "requires_story_plan": false,
      "requires_explicit_gates": true,
      "repo_hygiene_operation": false,
      "destructive_operation": false,
      "expected_runtime": "orchestration",
      "execution_profile": "orchestration-init",
      "workflow_verb": "review",
      "delegation_contract": {
        "allowed_paths": [
          "evals/results/",
          "packages/orchestration/"
        ],
        "out_of_scope_paths": [
          "packages/loops/ralph/",
          "tools/repo-hygiene/"
        ],
        "dependency_task_ids": [],
        "verify": {
          "command": "./scripts/rae.sh doctor"
        },
        "guard": {
          "rule": "eval metadata stays valid",
          "command": "python3 evals/scripts/validate_eval_metadata.py"
        },
        "required_evidence": [
          {
            "type": "command-log",
            "why": "show the orchestration entrypoint outcome",
            "required": true
          },
          {
            "type": "trace",
            "why": "prove the staged runtime emitted a trace",
            "required": true
          },
          {
            "type": "artifact",
            "why": "show the resulting pipeline state artifact",
            "required": true
          },
          {
            "type": "checkpoint",
            "why": "prove the required route checkpoint exists",
            "required": true
          }
        ],
        "fallback_rule": "escalate if the route requires changing package-local runtime behavior"
      },
      "claim_links": [
        "docs/reference/architecture/system-overview.md",
        "docs/how-to/choose-an-execution-model.md"
      ],
      "human_checkpoint": {
        "required": true,
        "gate_id": "tool-selection-orchestration",
        "title": "Approve orchestration route",
        "required_for": "execution"
      }
    },
