    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.146.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "jose": "6.2.8",
    "pg": "8.22.0",
    "smol-toml": "1.7.1",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <23 || >=24.0.0"
  }
