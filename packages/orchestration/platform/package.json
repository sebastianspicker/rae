{
  "name": "@rae/experimental-platform",
  "version": "0.1.0-experimental",
  "private": true,
  "type": "module",
  "description": "Experimental hosted control-plane and worker boundary for RAE.",
  "bin": {
    "rae-platform": "bin/rae-platform.mjs",
    "rae-platform-worker": "bin/rae-platform-worker.mjs"
