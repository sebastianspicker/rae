{
  "name": "@coding-agents-space/shared",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome lint --config-path ../../../biome.json --vcs-enabled=false src",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --config-path ../../../biome.json --vcs-enabled=false src",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@biomejs/biome": "2.5.9",
    "typescript": "5.9.3"
  }
}
