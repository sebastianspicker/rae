{
  "name": "trace-collector-skill",
  "private": true,
  "type": "module",
  "exports": {
    "./runner": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "biome lint --config-path ../../../biome.json --vcs-enabled=false src",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --config-path ../../../biome.json --vcs-enabled=false src",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@coding-agents-space/shared": "file:../_shared"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@biomejs/biome": "2.5.2",
    "typescript": "5.9.3"
  }
}
