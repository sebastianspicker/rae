{
  "name": "multi-model-review-skill",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "biome lint --config-path ../../../biome.json --vcs-enabled=false src",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --config-path ../../../biome.json --vcs-enabled=false src",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "@rae/dev-tools-shared": "file:../shared"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@biomejs/biome": "2.5.2",
    "typescript": "5.9.3"
  }
}
